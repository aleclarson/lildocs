{
  "name": "lildocs",
  "version": "0.0.0",
  "description": "A lightweight CLI that turns Markdown docs into a static searchable documentation site.",
  "bin": {
    "lildocs": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown && mkdir -p dist/render && cp src/render/styles.css src/render/search.js dist/render/",
    "format": "oxfmt --write src package.json tsconfig.json tsdown.config.ts .oxlintrc.json .oxfmtrc.json .vscode/settings.json",
    "format:check": "oxfmt --check src package.json tsconfig.json tsdown.config.ts .oxlintrc.json .oxfmtrc.json .vscode/settings.json",
    "lint": "oxlint src tsdown.config.ts",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cmd-ts": "^0.15.0",
    "gray-matter": "^4.0.3",
    "jiti": "^2.7.0",
    "marked": "^18.0.3",
    "preact": "^10.29.2",
    "preact-render-to-string": "^6.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.29.3"
}
