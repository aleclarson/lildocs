{
  "$schema": "../schemas/config.schema.json",
  "theme": {
    "light": "github-light",
    "dark": "github-dark"
  },
  "font": {
    "heading": "Onest",
    "body": "Geist",
    "code": "Geist Mono"
  },
  "background": {
    "gradient": "linear-gradient(135deg, rgb(121 184 255 / 0.14), transparent 38%)",
    "blendMode": "screen"
  },
  "link": {
    "underline": "hover"
  },
  "favicon": "./assets/favicon.svg",
  "logo": {
    "image": "./assets/logo.svg"
  },
  "navigation": {
    "duration": 125
  }
}
