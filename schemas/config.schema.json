{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aleclarson/lildocs/main/schemas/config.schema.json",
  "title": "lildocs config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema URL for editor validation."
    },
    "projectName": {
      "type": "string",
      "minLength": 1,
      "description": "Project name appended to each generated document title. Defaults to the nearest package.json name."
    },
    "theme": {
      "description": "Built-in lildocs theme or bundled Shiki theme name.",
      "oneOf": [
        {
          "title": "Built-in lildocs theme",
          "enum": ["default", "minimal"]
        },
        {
          "title": "Bundled Shiki theme",
          "enum": [
            "andromeeda",
            "aurora-x",
            "ayu-dark",
            "ayu-light",
            "ayu-mirage",
            "catppuccin-frappe",
            "catppuccin-latte",
            "catppuccin-macchiato",
            "catppuccin-mocha",
            "dark-plus",
            "dracula",
            "dracula-soft",
            "everforest-dark",
            "everforest-light",
            "github-dark",
            "github-dark-default",
            "github-dark-dimmed",
            "github-dark-high-contrast",
            "github-light",
            "github-light-default",
            "github-light-high-contrast",
            "gruvbox-dark-hard",
            "gruvbox-dark-medium",
            "gruvbox-dark-soft",
            "gruvbox-light-hard",
            "gruvbox-light-medium",
            "gruvbox-light-soft",
            "horizon",
            "horizon-bright",
            "houston",
            "kanagawa-dragon",
            "kanagawa-lotus",
            "kanagawa-wave",
            "laserwave",
            "light-plus",
            "material-theme",
            "material-theme-darker",
            "material-theme-lighter",
            "material-theme-ocean",
            "material-theme-palenight",
            "min-dark",
            "min-light",
            "monokai",
            "night-owl",
            "night-owl-light",
            "nord",
            "one-dark-pro",
            "one-light",
            "plastic",
            "poimandres",
            "red",
            "rose-pine",
            "rose-pine-dawn",
            "rose-pine-moon",
            "slack-dark",
            "slack-ochin",
            "snazzy-light",
            "solarized-dark",
            "solarized-light",
            "synthwave-84",
            "tokyo-night",
            "vesper",
            "vitesse-black",
            "vitesse-dark",
            "vitesse-light"
          ]
        }
      ]
    },
    "favicon": {
      "type": "string",
      "minLength": 1,
      "description": "Favicon URL, data URL, absolute URL path, or docs-relative image path."
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "$ref": "#/$defs/fontValue"
        },
        "body": {
          "$ref": "#/$defs/fontValue"
        },
        "code": {
          "$ref": "#/$defs/fontValue"
        }
      }
    },
    "logo": {
      "type": "object",
      "additionalProperties": false,
      "description": "Brand logo shown in the generated site header.",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "Logo image URL, data URL, absolute URL path, or docs-relative image path."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Logo text shown next to the logo image, or by itself when no image is configured."
        },
        "font": {
          "$ref": "#/$defs/fontValue"
        }
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional page background layered on top of the theme background color.",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "Background image URL, CSS url(...), or docs-relative image path."
        },
        "gradient": {
          "type": "string",
          "minLength": 1,
          "description": "CSS gradient value, such as linear-gradient(...)."
        },
        "blendMode": {
          "type": "string",
          "minLength": 1,
          "description": "CSS background-blend-mode value for the theme color and background layers."
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "description": "Link presentation options.",
      "properties": {
        "underline": {
          "enum": ["always", "hover", "none"],
          "description": "Controls when content links are underlined."
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Navigation ordering and enhanced navigation feel options.",
      "properties": {
        "order": {
          "type": "array",
          "description": "Docs-root-relative Markdown files or folders, in generated navigation order. Unlisted pages keep their generated order after listed siblings.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "transition": {
          "enum": ["fade", "slide", "scale", "instant"],
          "description": "Page transition preset used during enhanced navigation."
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "description": "Page transition duration in milliseconds."
        },
        "easing": {
          "type": "string",
          "minLength": 1,
          "description": "CSS timing function used by page transitions."
        }
      }
    }
  },
  "$defs": {
    "fontValue": {
      "type": "string",
      "minLength": 1,
      "description": "Google Fonts family name or local .woff2, .woff, .ttf, or .otf file path."
    }
  }
}
